{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pharmaconnect.uk/schemas/pharmacy-image-platform/asset-metadata.schema.json",
  "title": "PharmaConnectImagePlatformAssetMetadata",
  "type": "object",
  "required": [
    "schemaVersion",
    "assetId",
    "serviceId",
    "role",
    "version",
    "revision",
    "relativePath",
    "mimeType",
    "orientation",
    "aspectRatio",
    "licensing",
    "accessibility",
    "contentClass",
    "approval"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "assetId": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "serviceId": { "type": "string", "minLength": 1 },
    "role": { "enum": ["hero", "support", "trust", "conversion"] },
    "version": { "type": "integer", "minimum": 1 },
    "revision": { "type": "string", "minLength": 8, "maxLength": 64 },
    "relativePath": { "type": "string", "pattern": "^assets/pharmacy-image-platform/" },
    "mimeType": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fileSizeBytes": { "type": "integer", "minimum": 0 },
    "orientation": { "enum": ["landscape", "portrait", "square", "unknown"] },
    "aspectRatio": { "type": "string", "pattern": "^[0-9]+:[0-9]+$|^unknown$" },
    "licensing": {
      "type": "object",
      "required": ["holder", "licenseType", "rights"],
      "properties": {
        "holder": { "type": "string" },
        "licenseType": {
          "enum": [
            "pharmaconnect_owned",
            "client_owned",
            "stock_licensed",
            "editorial_licensed",
            "pending_clearance"
          ]
        },
        "rights": { "type": "string" },
        "expiry": { "type": "string", "format": "date" },
        "attribution": { "type": "string" },
        "territory": { "type": "string" }
      }
    },
    "accessibility": {
      "type": "object",
      "required": ["decorative", "altTextTemplate"],
      "properties": {
        "decorative": { "type": "boolean" },
        "altTextTemplate": { "type": "string", "minLength": 1 },
        "longDescription": { "type": "string" },
        "focusPriority": { "enum": ["high", "low", "none"] }
      }
    },
    "contentClass": {
      "enum": [
        "approved_photograph",
        "approved_editorial_illustration",
        "approved_tenant_generated",
        "approved_operator_selected",
        "placeholder",
        "decorative",
        "pending_review"
      ]
    },
    "approval": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected", "archived"] },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" },
        "rejectedReason": { "type": "string" },
        "operatorNotes": { "type": "string" }
      }
    },
    "subject": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

# Delivery pages are indexable. Replace any vhost or inherited robots header.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/(delivery/|sitemap-pilot\.xml)#">
    Header always unset X-Robots-Tag
    Header always set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  </If>
</IfModule>

{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --filter \"./artifacts/api-server\" --filter \"./artifacts/dashboard\" --filter \"./scripts\" --if-present run build",
    "pharmacy:visual:build": "tsx scripts/build-pharmacy-visual-experience-v1.ts pharmaconnect",
    "pharmacy:visual:validate": "tsx scripts/validate-pharmacy-visual-template-regression-v2.ts pharmaconnect",
    "pharmacy:visual:validate:final": "tsx scripts/validate-pharmacy-visual-final-fix-v1.ts pharmaconnect",
    "pharmacy:visual:validate:restore": "tsx scripts/validate-approved-pharmacy-template-restore-v1.ts pharmaconnect",
    "pharmacy:visual:images:seed": "tsx scripts/seed-visual-page-image-assignments-v1.ts pharmaconnect --force",
    "pharmacy:visual:validate:images": "tsx scripts/validate-visual-page-image-assignment-v1.ts pharmaconnect",
    "pharmacy:visual:validate:image-library": "tsx scripts/validate-pharmacy-image-library-workflow-v1.ts pharmaconnect travel-vaccinations",
    "pharmacy:visual:validate:image-upload-all-services": "tsx scripts/validate-pharmacy-image-upload-all-services-v1.ts pharmaconnect",
    "pharmacy:visual:validate:image-display-service": "tsx scripts/validate-pharmacy-image-display-invalid-service-v1.ts pharmaconnect",
    "pharmacy:authority:validate": "tsx scripts/validate-pharmacy-authority-readiness-v1.ts pharmaconnect",
    "pharmacy:authority:publish-gate:validate": "tsx scripts/validate-pharmacy-authority-publish-gate-v1.ts pharmaconnect",
    "pharmacy:authority:enhancement:validate": "tsx scripts/validate-pharmacy-authority-enhancement-engine-v1.ts pharmaconnect",
    "pharmacy:enhancement:workspace:validate": "tsx scripts/validate-pharmacy-enhancement-workspace-v1.ts pharmaconnect",
    "pharmacy:enhancement:workspace:simplification:validate": "tsx scripts/validate-pharmacy-enhancement-workspace-simplification-v2.ts pharmaconnect",
    "pharmacy:real-enhancement:validate": "tsx scripts/validate-pharmacy-real-enhancement-actions-v1.ts pharmaconnect pharmacy-first",
    "pharmacy:platform:workflow:validate": "tsx scripts/validate-platform-workflow-v1.ts pharmaconnect blood-pressure-checks",
    "pharmacy:platform:multi-campaign:validate": "tsx scripts/validate-multi-campaign-v1.ts pharmaconnect",
    "pharmacy:platform:dashboard:validate": "tsx scripts/validate-pharmacy-platform-dashboard-v1.ts pharmaconnect",
    "pharmacy:platform:operating-system:validate": "tsx scripts/validate-pharmacy-platform-operating-system-v1.ts pharmaconnect",
    "pharmacy:platform:workflow:ux:validate": "tsx scripts/validate-pharmacy-platform-workflow-ux-v2.ts pharmaconnect",
    "pharmacy:customer-experience:validate": "tsx scripts/validate-pharmacy-customer-experience-v1.ts pharmaconnect",
    "pharmacy:master-admin:validate": "tsx scripts/validate-pharmacy-master-admin-v1.ts",
    "pharmacy:commercial-readiness:validate": "tsx scripts/validate-pharmacy-commercial-readiness-v1.ts",
    "pharmacy:onboarding:services:validate": "tsx scripts/validate-pharmacy-onboarding-services-v1.ts",
    "pharmacy:self-provisioning:validate": "tsx scripts/validate-pharmacy-self-provisioning-v1.ts",
    "pharmacy:ui-workflow-polish:validate": "tsx scripts/validate-pharmacy-ui-workflow-polish-v1.ts pharmaconnect",
    "pharmacy:image-platform:init": "tsx scripts/pharmacy-image-platform-init.ts",
    "pharmacy:image-platform:validate": "tsx scripts/pharmacy-image-platform-validate.ts",
    "pharmacy:image-platform:populate:pharmacy-first": "tsx scripts/pharmacy-first-image-platform-populate.ts",
    "pharmacy:image-platform:gallery:validate": "tsx scripts/pharmacy-first-image-platform-gallery-validate.ts",
    "pharmacy:visual:pipeline": "pnpm run pharmacy:visual:images:seed && pnpm run pharmacy:visual:build && pnpm run pharmacy:visual:validate:restore && pnpm run pharmacy:visual:validate:images",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/api-server\" --filter \"./artifacts/dashboard\" --filter \"./scripts\" --if-present run typecheck",
    "post-deploy-check": "node scripts/post-deploy-check.mjs inboxingproweb",
    "release-check": "node scripts/release-check.mjs inboxingproweb"
  },
  "private": true,
  "devDependencies": {
    "playwright": "1.49.1",
    "prettier": "^3.8.1",
    "tsx": "catalog:",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.0",
    "basic-ftp": "^5.3.0",
    "cheerio": "^1.2.0",
    "openai": "^6.34.0",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "ssh2"
    ]
  }
}